# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Fases seguintes ---
# Cifra de credenciais de integração (openssl rand -base64 32)
ENCRYPTION_KEY=
# IA (Fase 4)
ANTHROPIC_API_KEY=
# Opcionais: modelo e esforço (padrão claude-opus-5-5 / low)
AI_MODEL=
AI_EFFORT=
# WhatsApp Business Cloud API (Fase 5)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Proteção do endpoint do worker / Vercel Cron
CRON_SECRET=
